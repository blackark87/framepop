  "components": {
    "schemas": {
      "Job": {
        "type": "object",
        "required": [
          "id",
          "state",
          "segmentIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "waiting",
              "generating",
              "internal_qc",
              "boundary_qc",
              "review_required",
              "passed",
              "failed",
              "cancelled"
            ]
          },
          "segmentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockedReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputVersion": {
            "type": "integer"
          },
          "connectionId": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "required": [
          "kind",
          "inputVersion"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "analyze",
              "image_generate",
              "image_edit",
              "video_generate",
              "face_qc"
            ]
          },
          "inputVersion": {
            "type": "integer",
            "minimum": 1
          },
          "segmentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "connectionId": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AUTH_REQUIRED",
              "POLICY_BLOCKED",
              "QUOTA_EXCEEDED",
              "OUTPUT_INVALID",
              "VERSION_CONFLICT",
              "CONNECTION_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "id",
          "flow",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "flow": {
            "enum": [
              "browser",
              "device_code"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "completed",
              "expired",
              "denied",
              "cancelled"
            ]
          },
          "verificationUrl": {
            "type": "string",
            "format": "uri"
          },
          "userCode": {
            "type": "string"
          }
        }
      }
    }
  }
